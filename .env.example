# Parameters for Vercel Postgres Templates
POSTGRES_URL=
# NextAuth Secret
AUTH_SECRET=

# ═══════════════════════════════════════════════════════════════
# 静态部署配置（GitHub Pages / Nginx / Cloudflare Pages 等）
# ═══════════════════════════════════════════════════════════════

# 启用静态模式（从 JSON 文件读取数据而非数据库）
# STATIC_MODE=true

# 静态部署的路径前缀（如果部署在子目录下需要设置）
# 示例：
#   - GitHub Pages: /Cherry (部署到 https://username.github.io/Cherry/)
#   - Nginx 子目录: /app (部署到 https://example.com/app/)
#   - 根路径部署: 留空或不设置
# NEXT_PUBLIC_BASE_PATH=/Cherry

